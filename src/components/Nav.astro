---
import { site } from '../data/site';
const path = Astro.url.pathname;
const is = (p: string) => path.startsWith(p);
---

<header class="nav">
  <div class="wrap">
    <a class="brand" href="/" title={site.handleMeaning} aria-label={`${site.handle}, home`}>
      <span>{site.handle}</span><span class="cursor" aria-hidden="true"></span>
      <span class="full">{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav-links">
        <li><a href="/#work">Work</a></li>
        <li><a href="/apps/" aria-current={is('/apps') ? 'page' : undefined}>Apps</a></li>
        <li><a href="/cv/" aria-current={is('/cv') ? 'page' : undefined}>CV</a></li>
        <li>
          <button class="theme-toggle" type="button" aria-label="Switch between light and dark theme" title="Light / dark">
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

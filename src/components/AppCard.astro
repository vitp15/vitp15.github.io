---
import type { App } from '../data/apps';
interface Props { app: App; index?: number }
const { app, index = 0 } = Astro.props;
const status = app.status === 'live' ? 'On Google Play' : app.status === 'beta' ? 'In testing' : 'Coming soon';
---

<a class="card tile" href={`/${app.slug}/`} style={`--c-light:${app.color};--c-dark:${app.colorDark};--t-light:${app.tint};--t-dark:${app.tintDark};--i:${index}`}>
  <img class="icon" src={`/img/apps/${app.slug}/icon-256.png`} width="64" height="64" alt="" />
  <div class="text">
    <h3>{app.name}</h3>
    <p class="tag">{app.tagline}</p>
    <p class="meta mono"><span class:list={['dot', app.status]} aria-hidden="true"></span>{status} · {app.platforms.join(' + ')} · {app.since}</p>
  </div>
</a>

<style>
  .card {
    --c: var(--c-dark); --t: var(--t-dark);
    display: flex; gap: 18px; align-items: flex-start; text-decoration: none; color: inherit;
    background: linear-gradient(150deg, color-mix(in srgb, var(--t) 70%, var(--tile)), var(--tile) 65%);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  :global(:root[data-theme='light']) .card { --c: var(--c-light); --t: var(--t-light); }
  .card:hover, .card:focus-visible { border-color: color-mix(in srgb, var(--c) 60%, var(--line)); transform: translateY(-2px); }
  .icon { width: 64px; height: 64px; border-radius: 16px; flex: none; box-shadow: 0 12px 28px -16px rgba(0,0,0,.7); }
  h3 { font-size: 1.2rem; letter-spacing: -0.02em; }
  .tag { margin: 4px 0 12px; color: var(--text-2); line-height: 1.45; font-size: 0.98rem; }
  .meta { margin: 0; font-size: 0.76rem; color: var(--muted); display: flex; align-items: center; flex-wrap: wrap; gap: 4px 6px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); display: inline-block; }
  .dot.live { background: var(--ok); } .dot.beta { background: var(--num); }
</style>
